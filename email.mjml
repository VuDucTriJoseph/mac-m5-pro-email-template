<mjml lang="en">
  <mj-head>
    <mj-title>Wellcome email mac pro m5</mj-title>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css?family=Inter:100,200,300,regular,500,600,700,800,900,100italic,200italic,300italic,italic,500italic,600italic,700italic,800italic,900italic"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Roboto, Arial, sans-serif" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width: 480px) {
        .mobile-h1 h1 {
          font-size: 24px !important;
          padding-bottom: 0px !important;
        }
        .mobile-des div {
          font-size: 16px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#000000">
    <mj-section>
      <mj-column>
        <mj-image
          src="https://i.postimg.cc/bJKvk0wh/my-Logo.png"
          alt="logo of developer"
          align="center"
          width="240px"
        />
      </mj-column>
    </mj-section>
    <mj-hero
      background-color="#000000"
      background-url="https://i.postimg.cc/W3Q4gm1j/Ellipse2.png"
      padding="40px 20px"
    >
      <mj-image
        src="https://i.postimg.cc/1tLzw03y/Gemini-Generated-Image-ga48zwga48zwga48.png"
        alt="mac-m5-image"
        border-radius="5px"
      />
      <mj-text
        color="#F5F5F7"
        align="center"
        padding="40px 0 30px"
        font-size="48px"
        font-weight="bold"
        css-class="mobile-h1"
      >
        <h1 style="font-size: 48px; font-weight: bold; color: #f5f5f7">
          Power to the Pros
        </h1>
      </mj-text>
      <mj-text
        padding="0 40px"
        color="#86868B"
        align="center"
        font-size="18px"
        font-weight="regular"
        css-class="mobile-des"
        line-height="100%"
      >
        The new Mac Pro with M5. Re-engineered for extreme performance
      </mj-text>
    </mj-hero>
    <mj-section padding="80px 5px 0 5px">
      <mj-column
        width="48%"
        padding="24px"
        background-color="#1C1C1E"
        border="1px solid rgba(256,256,256,.1)"
        border-radius="16px"
      >
        <mj-image
          align="left"
          src="https://i.postimg.cc/zBLBy28z/icon-chip.png"
          alt="icon chip"
          width="40px"
          padding-bottom="16px"
        />
        <mj-text padding-bottom="16px" color="#ffffff">
          <h2 style="font-size: 20px; font-weight: bold; color: #ffffff">
            M5 Pro Chip
          </h2>
        </mj-text>
        <mj-text
          color="#86868B"
          line-height="22px"
          font-size="14px"
          font-weight="regular"
          >Next-generation 2nm architecture. Up to 40% faster CPU performance
          for seamless multitasking
        </mj-text>
      </mj-column>
      <mj-column width="2%">
        <mj-spacer height="10px" />
      </mj-column>
      <!-- <mj-spacer height="10px" /> -->

      <mj-column
        width="48%"
        padding="24px"
        background-color="#1C1C1E"
        border="1px solid rgba(256,256,256,.1)"
        border-radius="16px"
      >
        <mj-image
          align="left"
          src="https://i.postimg.cc/xCkCXpn1/icon-GPU.png"
          alt="icon gpu"
          width="40px"
          padding-bottom="16px"
        />
        <mj-text padding-bottom="16px" color="#ffffff">
          <h2 style="font-size: 20px; font-weight: bold; color: #ffffff">
            Extreme GPU
          </h2>
        </mj-text>
        <mj-text
          color="#86868B"
          line-height="22px"
          font-size="14px"
          font-weight="regular"
          >Real-time 8K video rendering. Cinematic performance for 3D artists
          and developers.
        </mj-text></mj-column
      >
    </mj-section>
    <mj-section padding="10px 5px 60px 5px">
      <mj-column
        width="48%"
        padding="24px"
        background-color="#1C1C1E"
        border="1px solid rgba(256,256,256,.1)"
        border-radius="16px"
      >
        <mj-image
          align="left"
          src="https://i.postimg.cc/76C65twL/icon-memory.png"
          alt="icon memory"
          width="40px"
          padding-bottom="16px"
        />
        <mj-text padding-bottom="16px" color="#ffffff">
          <h2 style="font-size: 20px; font-weight: bold; color: #ffffff">
            Unified Memory
          </h2>
        </mj-text>
        <mj-text
          color="#86868B"
          line-height="22px"
          font-size="14px"
          font-weight="regular"
          >Up to 192GB of superfast memory. Zero lag, even with the most massive
          datasets.
        </mj-text>
      </mj-column>
      <mj-column width="2%">
        <mj-spacer height="10px" />
      </mj-column>

      <!-- <mj-spacer height="10px" /> -->

      <mj-column
        width="48%"
        padding="24px"
        background-color="#1C1C1E"
        border="1px solid rgba(256,256,256,.1)"
        border-radius="16px"
      >
        <mj-image
          align="left"
          src="https://i.postimg.cc/QtBtFYhX/icon-cooling.png"
          alt="icon cooling"
          width="40px"
          padding-bottom="16px"
        />
        <mj-text padding-bottom="16px" color="#ffffff">
          <h2 style="font-size: 20px; font-weight: bold; color: #ffffff">
            Advanced Cooling
          </h2>
        </mj-text>
        <mj-text
          color="#86868B"
          line-height="22px"
          font-size="14px"
          font-weight="regular"
          >Revolutionary thermal system remains whisper-quiet under heavy
          workloads.
        </mj-text></mj-column
      >
    </mj-section>

    <mj-section padding="0 40px 100px 40px">
      <mj-column>
        <mj-raw>
          <style> .apple-btn { display: inline-block; color: #ffffff !important;
          font-family: 'Inter', Helvetica, Arial, sans-serif; font-size: 18px;
          font-weight: bold; text-decoration: none; border-radius: 8px; /* Đổ
          dải màu Gradient */ background: #bf5af2; background:
          linear-gradient(to bottom, #bf5af2, #5e5ce6); /* Padding mặc định cho
          bản Desktop */ padding: 16px 40px; text-align: center; } /* Responsive
          dành riêng cho Mobile */ @media only screen and (max-width: 480px) {
          .apple-btn { display: block !important; /* Thay đổi padding tùy ý trên
          Mobile tại đây */ padding: 14px 0px !important; font-size: 16px
          !important; width: 100% !important; } /* Ép cái bảng thô giãn rộng
          100% trên mobile */ .table-container { width: 100% !important; } }
          </style> <table class="table-container" border="0" cellspacing="0"
          cellpadding="0" align="center"> <tr> <td align="center"> <a href="#"
          class="apple-btn" aria-label="Order the new Mac Pro M5 now">Order
          Now</a> </td> </tr> </table>
        </mj-raw>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text align="center" color="#86868B" font-size="12px">
          <a
            href="#1"
            target="_blank"
            style="text-decoration: none; color: #86868b"
            aria-label="Visit our physical Showroom"
            >Visit our Showroom</a
          >
          |
          <a
            href="#1"
            target="_blank"
            style="text-decoration: none; color: #86868b"
            aria-label="View this email in your web browser"
            >View Online</a
          ></mj-text
        >
        <mj-text align="center" color="#86868B" font-size="12px"
          >You're receiving this because you're a Mac enthusiast.
          <a
            href="#1"
            target="_blank"
            style="text-decoration: none; color: #86868b"
            aria-label="Unsubscribe from this mailing list"
            >Unsubscribe.</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
