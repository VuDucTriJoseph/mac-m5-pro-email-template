<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Your Order Receipt - Mac Pro M5</mj-title>
    <mj-preview
      >Thank you for your order! View your receipt and delivery status
      inside.</mj-preview
    >
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css?family=Inter:100,200,300,regular,500,600,700,800,900,100italic,200italic,300italic,italic,500italic,600italic,700italic,800italic,900italic"
    />
    <mj-attributes>
      <mj-all
        font-family="'Inter',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="14px" color="#1D1D1F" line-height="1.5" />
    </mj-attributes>
    <mj-style>
      /* CSS Media Queries sẽ được viết tại đây */
    </mj-style>
  </mj-head>
  <mj-body background-color="#e5e5ea">
    <mj-wrapper
      background-color="#ffffff"
      padding="32px 20px"
      border-radius="16px"
    >
      <!-- KHU VỰC 1: Header (Logo & Order ID) -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-image
            src="./image/logo-light.png"
            alt="my logo"
            width="198px"
            align="left"
            padding="0"
          />
          <mj-text
            align="left"
            font-size="24px"
            font-weight="bold"
            color="#000000"
            padding="24px 0px 8px 0px"
            >Order Confirmed
          </mj-text>
          <mj-text
            align="left"
            font-size="12px"
            font-weight="bold"
            color="#86868B"
            padding="0px"
          >
            Order ID: W123456789 • June 15, 2026
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px"
          />
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 2: Product List -->
      <mj-section padding="0px">
        <mj-group width="100%">
          <mj-column width="18%" vertical-align="middle">
            <mj-image
              src="./image/m5_mini_product.jpeg"
              alt="Mac Pro M5"
              width="64px"
              border="1px solid #1D1D1F"
              border-radius="8px"
              padding="0px"
              align="left"
            />
          </mj-column>
          <mj-column width="47%" vertical-align="middle" padding-left="12px">
            <mj-text
              font-size="14px"
              font-weight="bold"
              color="#1D1D1F"
              padding="0px 0px 4px 0px"
            >
              Mac Pro M5 (standard)
            </mj-text>
            <mj-text font-size="12px" color="#86868B" padding="0px">
              Space Black • 64GB • 2TB
            </mj-text>
          </mj-column>

          <!-- CỘT 3: Số lượng -->
          <mj-column width="10%" vertical-align="middle">
            <mj-text
              font-size="14px"
              color="#86868B"
              padding="0px"
              align="center"
            >
              x1
            </mj-text>
          </mj-column>

          <!-- CỘT 4: Giá tiền -->
          <mj-column width="25%" vertical-align="middle">
            <mj-text
              font-size="16px"
              font-weight="bold"
              color="#1D1D1F"
              padding="0px"
              align="right"
            >
              $6,999.00
            </mj-text>
          </mj-column>
        </mj-group>
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text font-size="14px" color="#86868B" padding="4px 0px">
            Subtotal
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            font-weight="600"
            color="#1D1D1F"
            align="right"
            padding="4px 0px"
          >
            $6,999.00
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dòng 2: Phí giao hàng (Shipping) -->
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text font-size="14px" color="#86868B" padding="4px 0px">
            Shipping
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            font-weight="600"
            color="#1D1D1F"
            align="right"
            padding="4px 0px"
          >
            Free
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dòng 3: Thuế (Estimated Tax) -->
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text font-size="14px" color="#86868B" padding="4px 0px">
            Tax (VAT 8%)
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            font-weight="600"
            color="#1D1D1F"
            align="right"
            padding="4px 0px"
          >
            $559.92
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ĐƯỜNG KẺ TRƯỚC TỔNG CỘNG -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="16px 0px"
          />
        </mj-column>
      </mj-section>

      <!-- Dòng 4: TỔNG CỘNG (GRAND TOTAL) -->
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="20px"
            font-weight="bold"
            color="#1D1D1F"
            padding="0px"
          >
            Total
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="20px"
            font-weight="700"
            color="#1D1D1F"
            align="right"
            padding="0px"
          >
            $7,558.92
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="24px">
        <mj-column width="100%">
          <mj-button
            href="#"
            background-color="#0071e3"
            color="#ffffff"
            font-size="16px"
            font-weight="bold"
            border-radius="8px"
            width="100%"
            padding="0"
            inner-padding="16px 24px"
          >
            Track Your Shipment
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 3: Progress Bar -->
      <!-- ĐƯỜNG PHÂN CÁCH TRƯỚC TRACKING -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px 32px 0px"
          />
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 4: TIẾN TRÌNH GIAO HÀNG (SHIPPING TRACKER) -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-text
            font-size="18px"
            font-weight="700"
            color="#1D1D1F"
            padding="0px 0px 16px 0px"
          >
            Delivery Status
          </mj-text>

          <!-- Nhúng HTML thuần qua mj-raw để thiết lập WAI-ARIA -->
          <mj-raw>
            <div role="progressbar" aria-valuenow="50" aria-valuemin="0"
            aria-valuemax="100" aria-label="Order is currently being processed">
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- Dùng mj-group để 4 bước giao hàng dính chặt trên 1 hàng ngang -->
      <mj-section padding="0px">
        <mj-group width="100%">
          <!-- Bước 1: Ordered (Hoàn thành - Nhấn mạnh bằng chữ đậm và màu đen) -->
          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="18px"
              color="#1D1D1F"
              padding="0px"
            >
              ●
            </mj-text>
            <mj-text
              align="center"
              font-size="12px"
              font-weight="700"
              color="#1D1D1F"
              padding="8px 0px 0px 0px"
            >
              Ordered
            </mj-text>
          </mj-column>

          <!-- Bước 2: Processing (Trạng thái hiện tại) -->
          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="18px"
              color="#1D1D1F"
              padding="0px"
            >
              ●
            </mj-text>
            <mj-text
              align="center"
              font-size="12px"
              font-weight="700"
              color="#1D1D1F"
              padding="8px 0px 0px 0px"
            >
              Processing
            </mj-text>
          </mj-column>

          <!-- Bước 3: Shipped (Chưa tới - Làm mờ đi bằng màu xám) -->
          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="18px"
              color="#E5E5EA"
              padding="0px"
            >
              ●
            </mj-text>
            <mj-text
              align="center"
              font-size="12px"
              font-weight="400"
              color="#86868B"
              padding="8px 0px 0px 0px"
            >
              Shipped
            </mj-text>
          </mj-column>

          <!-- Bước 4: Delivered (Chưa tới) -->
          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="18px"
              color="#E5E5EA"
              padding="0px"
            >
              ●
            </mj-text>
            <mj-text
              align="center"
              font-size="12px"
              font-weight="400"
              color="#86868B"
              padding="8px 0px 0px 0px"
            >
              Delivered
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <!-- Đóng thẻ progressbar -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-raw> </div> </mj-raw>
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 4: TIẾN TRÌNH GIAO HÀNG (HYBRID PROGRESS BAR) -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-text
            font-size="18px"
            font-weight="700"
            color="#1D1D1F"
            padding="0px 0px 16px 0px"
          >
            Delivery Status
          </mj-text>

          <mj-raw>
            <div role="progressbar" aria-valuenow="50" aria-valuemin="0"
            aria-valuemax="100" aria-label="Order is currently being processed">
          </mj-raw>

          <!-- Tấm ảnh thanh ngang + dấu chấm tròn bạn xuất từ Figma -->
          <mj-image
            src="./image/process_bar_state_1.png"
            alt="Progress: Processing"
            padding="0px 16px 8px 16px"
            align="center"
          />
        </mj-column>
      </mj-section>

      <!-- Dùng mj-group để 4 nhãn text căn lề thẳng hàng với 4 dấu chấm trên ảnh -->
      <mj-section padding="0px">
        <mj-group width="100%">
          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="12px"
              font-weight="700"
              color="#1D1D1F"
              padding="0px"
            >
              Ordered
            </mj-text>
          </mj-column>

          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="12px"
              font-weight="700"
              color="#1D1D1F"
              padding="0px"
            >
              Processing
            </mj-text>
          </mj-column>

          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="12px"
              font-weight="400"
              color="#86868B"
              padding="0px"
            >
              Shipped
            </mj-text>
          </mj-column>

          <mj-column width="25%">
            <mj-text
              align="center"
              font-size="12px"
              font-weight="400"
              color="#86868B"
              padding="0px"
            >
              Delivered
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-raw> </div> </mj-raw>
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 4: Cross-sell -->

      <!-- KHU VỰC 5: Footer & Utilities -->
    </mj-wrapper>
  </mj-body>
</mjml>
