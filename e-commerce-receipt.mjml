<mjml lang="en" dir="ltr">
  <mj-head>
    <mj-title>Your Order Receipt - Mac Pro M5</mj-title>
    <mj-preview
      >Thank you for your order! View your receipt and delivery status
      inside.</mj-preview
    >
    <mj-raw>
      <meta name="color-scheme" content="light dark"> <meta
      name="supported-color-schemes" content="light dark">
    </mj-raw>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css?family=Inter:100,200,300,regular,500,600,700,800,900,100italic,200italic,300italic,italic,500italic,600italic,700italic,800italic,900italic"
    />
    <mj-attributes>
      <mj-all
        font-family="'Inter',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      />
      <mj-text font-size="14px" color="#1D1D1F" line-height="1.5" />
      <mj-class name="hidden-defald" display="none" />
    </mj-attributes>

    <mj-style>
      .dark-logo {
        display: none !important;
        mso-hide: all !important;
        overflow: hidden;
        max-height: 0px;
      }

      @media (prefers-color-scheme: dark) {
        /* 1. Lật màu nền ứng dụng (Body) sang Xám đen đậm */
        body,
        .body-bg,
        div[css-class="body-bg"],
        table[id="outlook-holder"] {
          background-color: #121212 !important;
        }

        /* Hack ép màu nền cho toàn bộ các thẻ div lớn chứa nội dung */
        .body-bg > div {
          background-color: #121212 !important;
        }

        /* 2. Lật màu nền tờ Hóa đơn (Wrapper) sang màu Xám iOS chuẩn (#1C1C1E) */
        .dark-wrapper > table {
          background-color: #1c1c1e !important;
        }
        .dark-crosssell-bg > table {
          background-color: #38383a !important;
          border-color: #3a3a3c !important;
        }
        .dark-crosssell-col-bg > table {
          background-color: #2c2c2e !important;
        }

        /* 3. Lật toàn bộ chữ Tiêu đề và Văn bản chính sang màu Trắng/Xám sáng Apple (#F5F5F7) */
        .dark-text div,
        .dark-title div {
          color: #f5f5f7 !important;
        }

        /* 4. Lật chữ chú thích phụ sang màu Xám sáng hơn để đảm bảo độ tương phản */
        .dark-subtext div {
          color: #a1a1a6 !important;
        }

        /* 5. Ép các đường kẻ phân cách chuyển sang màu xám tối */
        .dark-divider p {
          border-color: #3a3a3c !important;
        }
        .light-logo {
          display: none !important;
        }
        .dark-logo {
          display: block !important;
          max-height: none !important;
          overflow: visible !important;
          float: none !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#e5e5ea" css-class="body-bg">
    <mj-wrapper
      background-color="#ffffff"
      padding="32px 20px"
      border-radius="16px"
      css-class="dark-wrapper"
    >
      <!-- KHU VỰC 1: Header (Logo & Order ID) -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-image
            css-class="light-logo"
            src="./image/logo-light.png"
            alt="Brand Logo"
            width="198px"
            align="left"
            padding="0px"
          />

          <mj-image
            css-class="dark-logo"
            mj-class="hidden-defald"
            src="./image/logo-dark.png"
            alt="Brand Logo"
            width="198px"
            align="left"
            padding="0px"
          />
          <mj-text
            align="left"
            font-size="24px"
            font-weight="bold"
            color="#000000"
            padding="24px 0px 8px 0px"
            css-class="dark-text"
            >Order Confirmed
          </mj-text>
          <mj-text
            align="left"
            font-size="12px"
            font-weight="bold"
            color="#86868B"
            padding="0px"
            css-class="dark-subtext"
          >
            Order ID: W123456789 • June 15, 2026
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column width="100%">
          <mj-divider
            css-class="dark-divider"
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px"
          />
        </mj-column>
      </mj-section>

      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-text
            font-size="18px"
            font-weight="700"
            color="#1D1D1F"
            padding="0px 0px 16px 0px"
            css-class="dark-text"
          >
            Delivery Status
          </mj-text>

          <mj-raw>
            <div role="progressbar" aria-valuenow="50" aria-valuemin="0"
            aria-valuemax="100" aria-label="Order is currently being processed">
          </mj-raw>

          <!-- Tấm ảnh thanh ngang + dấu chấm tròn bạn xuất từ Figma -->
          <mj-image
            src="./image/process_bar_state_1.png"
            alt="Progress: Processing"
            padding="0px 16px 8px 16px"
            align="center"
          />
        </mj-column>
      </mj-section>

      <!-- Dùng mj-group để 4 nhãn text căn lề thẳng hàng với 4 dấu chấm trên ảnh -->
      <mj-section padding="0px">
        <mj-group width="100%">
          <mj-column>
            <mj-text
              align="left"
              font-size="12px"
              font-weight="700"
              color="#1D1D1F"
              padding="0px"
              css-class="dark-text"
            >
              Ordered
            </mj-text>
          </mj-column>

          <mj-column>
            <mj-text
              align="center"
              font-size="12px"
              font-weight="400"
              color="#86868B"
              padding="0px"
              css-class="dark-subtext"
            >
              Shipped
            </mj-text>
          </mj-column>

          <mj-column>
            <mj-text
              align="right"
              font-size="12px"
              font-weight="400"
              color="#86868B"
              padding="0px"
              css-class="dark-subtext"
            >
              Delivered
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-raw> </div> </mj-raw>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column width="100%">
          <mj-divider
            css-class="dark-divider"
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px"
          />
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 2: Product List -->
      <mj-section padding="0px">
        <mj-group width="100%">
          <mj-column width="18%" vertical-align="middle">
            <mj-image
              src="./image/m5_mini_product.jpeg"
              alt="Mac Pro M5"
              width="64px"
              border="1px solid #1D1D1F"
              border-radius="8px"
              padding="0px"
              align="left"
            />
          </mj-column>
          <mj-column width="47%" vertical-align="middle" padding-left="12px">
            <mj-text
              font-size="14px"
              font-weight="bold"
              color="#1D1D1F"
              padding="0px 0px 4px 0px"
              css-class="dark-text"
            >
              Mac Pro M5 (standard)
            </mj-text>
            <mj-text
              font-size="12px"
              color="#86868B"
              padding="0px"
              css-class="dark-subtext"
            >
              Space Black • 64GB • 2TB
            </mj-text>
          </mj-column>

          <!-- CỘT 3: Số lượng -->
          <mj-column width="10%" vertical-align="middle">
            <mj-text
              font-size="14px"
              color="#86868B"
              padding="0px"
              align="center"
              css-class="dark-subtext"
            >
              x1
            </mj-text>
          </mj-column>

          <!-- CỘT 4: Giá tiền -->
          <mj-column width="25%" vertical-align="middle">
            <mj-text
              font-size="16px"
              font-weight="bold"
              color="#1D1D1F"
              padding="0px"
              align="right"
              css-class="dark-text"
            >
              $6,999.00
            </mj-text>
          </mj-column>
        </mj-group>
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px"
            css-class="dark-divider"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            color="#86868B"
            padding="4px 0px"
            css-class="dark-subtext"
          >
            Subtotal
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            font-weight="600"
            color="#1D1D1F"
            align="right"
            padding="4px 0px"
            css-class="dark-text"
          >
            $6,999.00
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dòng 2: Phí giao hàng (Shipping) -->
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            color="#86868B"
            padding="4px 0px"
            css-class="dark-subtext"
          >
            Shipping
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            font-weight="600"
            color="#1D1D1F"
            align="right"
            padding="4px 0px"
            css-class="dark-text"
          >
            Free
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dòng 3: Thuế (Estimated Tax) -->
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            color="#86868B"
            padding="4px 0px"
            css-class="dark-subtext"
          >
            Tax (VAT 8%)
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="14px"
            font-weight="600"
            color="#1D1D1F"
            align="right"
            padding="4px 0px"
            css-class="dark-text"
          >
            $559.92
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- ĐƯỜNG KẺ TRƯỚC TỔNG CỘNG -->
      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="16px 0px"
            css-class="dark-divider"
          />
        </mj-column>
      </mj-section>

      <!-- Dòng 4: TỔNG CỘNG (GRAND TOTAL) -->
      <mj-section padding="0px">
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="20px"
            font-weight="bold"
            color="#1D1D1F"
            padding="0px"
            css-class="dark-text"
          >
            Total
          </mj-text>
        </mj-column>
        <mj-column width="50%" vertical-align="middle">
          <mj-text
            font-size="20px"
            font-weight="700"
            color="#1D1D1F"
            align="right"
            padding="0px"
            css-class="dark-text"
          >
            $7,558.92
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="24px">
        <mj-column width="100%">
          <mj-button
            href="#"
            background-color="#0071e3"
            color="#ffffff"
            font-size="16px"
            font-weight="bold"
            border-radius="8px"
            width="100%"
            padding="0"
            inner-padding="16px 24px"
          >
            Track Your Shipment
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 3: Progress Bar -->

      <mj-section padding="0px">
        <mj-column width="100%">
          <mj-divider
            border-width="1px"
            border-color="#E5E5EA"
            padding="24px 0px 32px 0px"
            css-class="dark-divider"
          />
        </mj-column>
      </mj-section>

      <!-- KHU VỰC 4: TIẾN TRÌNH GIAO HÀNG (HYBRID PROGRESS BAR) -->

      <!-- KHU VỰC 4: Cross-sell -->

      <mj-section
        border="solid 1px #E5E5EA"
        border-radius="8px"
        padding="19px 29px"
        css-class="dark-crosssell-bg"
      >
        <mj-column
          width="100%"
          background-color="#fafafa"
          css-class="dark-crosssell-col-bg"
        >
          <mj-text
            font-size="18px"
            font-weight="700"
            color="#1D1D1F"
            padding="16px 0px 16px 0px"
            align="center"
            css-class="dark-text"
          >
            Complete Your Setup
          </mj-text>
        </mj-column>
        <mj-column
          width="50%"
          background-color="#fafafa"
          css-class="dark-crosssell-col-bg"
        >
          <mj-image
            src="./image/keyboard_crosssel.png"
            alt="keyboard"
            width="120px"
            padding-bottom="8px"
          />
          <mj-text
            font-size="14px"
            font-weight="bold"
            align="center"
            color="#000000"
            padding-bottom="8px"
            css-class="dark-text"
          >
            Magic Keyboard</mj-text
          >
          <mj-text
            font-size="14px"
            font-weight="bold"
            align="center"
            color="#86868b"
            padding-bottom="8px"
            css-class="dark-subtext"
          >
            $199.00</mj-text
          >
          <mj-text align="center">
            <a
              href="#"
              style="
                color: #0071e3;
                font-size: 14px;
                font-weight: bold;
                text-decoration: none;

                display: inline-block;
                font-family: -apple-system, sans-serif;
              "
              >+ Add to Order</a
            ></mj-text
          ></mj-column
        >
        <mj-column
          width="50%"
          background-color="#fafafa"
          css-class="dark-crosssell-col-bg"
        >
          <mj-image
            src="./image/mouse_logi_crosssell.png"
            alt="keyboard"
            width="120px"
            padding-bottom="8px"
          />
          <mj-text
            font-size="14px"
            font-weight="bold"
            align="center"
            color="#000000"
            padding-bottom="8px"
            css-class="dark-text"
          >
            Magic Mouse</mj-text
          >
          <mj-text
            font-size="14px"
            font-weight="bold"
            align="center"
            color="#86868b"
            padding-bottom="8px"
            css-class="dark-subtext"
          >
            $99.00</mj-text
          >
          <mj-text align="center">
            <a
              href="#"
              style="
                color: #0071e3;
                font-size: 14px;
                font-weight: bold;
                text-decoration: none;

                display: inline-block;
                font-family: -apple-system, sans-serif;
              "
              >+ Add to Order</a
            ></mj-text
          ></mj-column
        >
      </mj-section>
    </mj-wrapper>
    <!-- KHU VỰC 5: Footer & Utilities -->
    <mj-section padding="24px 30px">
      <mj-column width="100%">
        <mj-image
          src="./image/QR Code.png"
          alt="qr-code"
          width="120px"
          padding-bottom="24px"
        />
      </mj-column>
      <mj-column width="50%"
        ><mj-text align="center">
          <a
            href="#"
            style="
              color: #86868b;
              font-size: 13px;
              font-weight: bold;
              text-decoration: none;

              display: inline-block;
            "
            >↓ Download PDF Invoice</a
          >
        </mj-text>
      </mj-column>
      <mj-column width="50%"
        ><mj-text align="center">
          <a
            href="#"
            style="
              color: #86868b;
              font-size: 13px;
              font-weight: bold;
              text-decoration: none;

              display: inline-block;
            "
            >+ Add to Apple Wallet</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="32px 20px 20px 20px">
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="12px"
          color="#86868B"
          padding="0px 0px 12px 0px"
        >
          Need help with your order?
          <a
            href="https://support.apple.com"
            style="color: #0071e3; text-decoration: none"
            >Contact Support</a
          >
        </mj-text>

        <mj-text
          align="center"
          font-size="12px"
          color="#86868B"
          line-height="1.5"
          padding="0px 0px 12px 0px"
        >
          Copyright © 2026 Apple Inc. <br />
          One Apple Park Way, Cupertino, CA 95014, USA. <br />
          All rights reserved.
        </mj-text>

        <mj-text align="center" font-size="12px" color="#86868B" padding="0px">
          <a
            href="{{privacy_url}}"
            style="color: #86868b; text-decoration: underline"
            >Privacy Policy</a
          >
          &nbsp; • &nbsp;
          <a
            href="{{unsubscribe_url}}"
            style="color: #86868b; text-decoration: underline"
            >Unsubscribe</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
